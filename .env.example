# 环境变量配置示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# agent_config.json 中的 ${VAR:} 会在加载时解析为对应环境变量（未设则用空串）

# --- 密钥加密主密钥（secret_store 加解密 enc: 密文用）---
# 用于加密 agent_config.json 里的 LLM api_key / DB password 等敏感字段。
# 加密：python command/encrypt_secret.py encrypt "明文" → 输出 enc: 密文 → 贴回 config
# 运行时 config_loader/llm_factory 自动解密；明文（无 enc: 前缀）原样向下兼容。
# 生产环境务必设置，且不要入库/不要落盘到代码仓库。
JASYPT_MASTER_KEY=

# --- 限流共享 Redis（多 worker 部署用）---
# Dockerfile 4 worker 部署时，slowapi 需共享 Redis 才能正确限流（否则每 worker 独立计数=配置×4）
# 本地开发不设此变量：slowapi 自动用 in-memory（向下兼容，无需 Redis）
# docker-compose 部署时 backend 自动设 REDIS_URL=redis://redis:6379/1（见 docker/docker-compose.yml）
# REDIS_URL=redis://localhost:6379/1

# --- 认证 ---
# JWT 签发/校验密钥。未设置时回退到 agent_config.json 的 jwt_secret（本地开发默认值），
# 但启动会打印安全告警。生产必须设置强随机值。
JWT_SECRET=
# CORS 允许的源（逗号分隔，如 https://app.example.com,https://admin.example.com）。
# 未设置时回退本地白名单 http://localhost:3000，启动打印告警。生产必须设置真实域名。
CORS_ORIGINS=
JWT_DEFAULT_TOKEN=Bearer eyJ0eXAi...

# --- Embedding（DashScope）---
DASHSCOPE_API_KEY=sk-xxxxxxxx

# --- 内网异步文件解析 ---
INTERNAL_PARSE_API_KEY=

# --- MinIO 对象存储 ---
MINIO_SECRET_KEY=

# --- MinerU（已在 agent_config.json 用 ${MINERU_API_KEY:}）---
MINERU_API_KEY=

# --- 日志路径（容器内固定 /logs，挂载到 ./logs）---
LOG_DIR=/logs
